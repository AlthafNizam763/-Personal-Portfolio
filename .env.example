# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/portfolio
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority"

# Secret used to sign admin session cookies (JWT, HS256).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Changing it logs every admin out.
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Public site URL — used for canonical links, Open Graph tags, sitemap.xml
# and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ---------------------------------------------------------------------------
# File uploads
# ---------------------------------------------------------------------------
# On Vercel the filesystem is read-only, so uploads go to Vercel Blob.
# Create a Blob store in your Vercel project (Storage -> Blob) and Vercel will
# inject this automatically -- do NOT copy this placeholder into the Vercel
# dashboard, as a hand-added variable blocks the real token from being injected
# and every upload then fails with a 503.
# Locally you can leave it blank: uploads then fall back to writing into
# `public/uploads/`.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Seeding (used only by `npm run seed` and `npm run create-admin`)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"

# ---------------------------------------------------------------------------
# Contact-form notifications
# ---------------------------------------------------------------------------
# When a visitor's message is saved, the server notifies you by email,
# WhatsApp and/or browser push. Channels are independent: leave one
# unconfigured and only the others run. Everything here is server-side only —
# none of these names start with NEXT_PUBLIC_, so no credential reaches the
# browser bundle.
#
# WHICH SWITCH DOES WHAT
#   Admin panel (Settings -> Notifications) is the day-to-day on/off switch.
#   It is stored in the database and read fresh on every submission.
#
#   NOTIFY_<CHANNEL>_ENABLED below is a deployment kill switch. Set it to
#   "false" and that channel can never fire from this deployment, whatever the
#   admin panel says — useful for a staging environment pointed at the
#   production database. Leave it unset (or "true") to let the panel decide.
#
# A channel that is switched on but missing credentials is reported as
# "misconfigured" and shown as such next to its toggle in the admin panel.
#
# Verify a channel without using the live form:  npm run test-notification

# Per-channel network budget, in ms. Keep it under your serverless timeout.
NOTIFY_TIMEOUT_MS="8000"

# IANA timezone used for the "Submitted" line. Defaults to UTC.
NOTIFY_TIMEZONE="Asia/Kolkata"

# --- Email -----------------------------------------------------------------
NOTIFY_EMAIL_ENABLED=""

# "resend" (default) or "sendgrid". Both are plain HTTPS APIs — no SDK needed.
EMAIL_PROVIDER="resend"

# API key for the provider above. Only the matching one is read.
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# Sender. Must be an address on a domain you have verified with the provider;
# a display name is optional.  Example: Portfolio <notify@your-domain.com>
NOTIFY_EMAIL_FROM=""

# Where the notification goes — your inbox. Comma-separate for several.
# Reply-To is set to the visitor, so replying answers them directly.
NOTIFY_EMAIL_TO=""

# Optional extra recipients, blind-copied.
NOTIFY_EMAIL_BCC=""

# --- WhatsApp --------------------------------------------------------------
NOTIFY_WHATSAPP_ENABLED=""

# "meta" (default, WhatsApp Cloud API) or "twilio".
WHATSAPP_PROVIDER="meta"

# Your WhatsApp number, in E.164. Spaces, dashes and a leading + are fine —
# they are normalised for whichever provider is in use.
WHATSAPP_TO="+919876543210"

# --- WhatsApp via Meta Cloud API ---
# From developers.facebook.com -> your app -> WhatsApp -> API Setup.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"

# IMPORTANT: Cloud API only delivers free-form text to someone who messaged
# your business number in the last 24 hours, which a notification to yourself
# normally is not (you would get error 131047). Create an approved template
# with four body placeholders and name it here to send that instead:
#   {{1}} name   {{2}} email   {{3}} subject   {{4}} message
# Leaving this blank sends plain text, which is fine for testing inside the
# 24-hour window.
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en_US"

# --- WhatsApp via Twilio ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Your approved sender, or the sandbox number whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=""

# --- Browser / push notifications ------------------------------------------
NOTIFY_PUSH_ENABLED=""

# Web Push needs a VAPID key pair. Generate one and paste both lines here:
#   npm run generate-vapid-keys
# The public key is handed to browsers so they can subscribe; the private key
# signs every push and must stay secret. Keep the pair stable — replacing it
# unsubscribes every device, which then has to be re-enabled from
# Admin -> Settings -> Notifications.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Contact address push services can reach you at, as a mailto: or https: URL.
# Defaults to your first NOTIFY_EMAIL_TO, then to the site URL.
VAPID_SUBJECT=""

# How long a push service should keep trying to deliver, in seconds.
PUSH_TTL_SECONDS="86400"
